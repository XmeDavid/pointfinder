# pgBackRest configuration for the PointFinder production Patroni pair.
# PLACEHOLDER FILE: copy to a root-owned secrets location on BOTH database hosts,
# replace every REPLACE_* value, and never commit the filled-in copy.
# Option names verified against https://pgbackrest.org/configuration.html (2.59.1).
#
# One repository shared by both hosts: the versioned, private Hetzner backups
# bucket. Both the primary (archive-push, backups) and the standby (archive-get,
# possible future restores) read the same stanza, so a failover keeps one
# continuous archive timeline history.

[global]
repo1-type=s3
repo1-s3-endpoint=fsn1.your-objectstorage.com
repo1-s3-region=fsn1
repo1-s3-bucket=pointfinder-prod-backups-202609
# Path-style avoids a bucket-name-as-hostname TLS dependency on this provider.
repo1-s3-uri-style=path
repo1-s3-key=REPLACE_WITH_BACKUP_ONLY_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_BACKUP_ONLY_SECRET_KEY
repo1-path=/pgbackrest
# Client-side encryption. The passphrase is the recovery key: without it every
# backup and WAL segment in the bucket is unreadable. Cipher settings cannot be
# changed after stanza-create.
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_LONG_RANDOM_PASSPHRASE
# Retention: four weekly fulls (~one month), up to seven full/differential
# backups; archived WAL is kept for every retained full.
repo1-retention-full-type=count
repo1-retention-full=4
repo1-retention-diff=7
# Bundling and block incremental keep the object count and diff sizes small.
repo1-bundle=y
repo1-block=y

compress-type=zst
compress-level=3
process-max=2
start-fast=y
# Console output is discarded by the runner; the file log is the record.
log-level-console=off
log-level-file=detail
log-path=/var/log/pgbackrest
lock-path=/tmp/pgbackrest
spool-path=/var/spool/pgbackrest
archive-check=y
archive-header-check=y

[pointfinder-production]
# Same path in the Patroni container and in the sidecar (shared PGDATA volume).
pg1-path=/var/lib/postgresql/data
pg1-port=5432
# Shared socket directory volume; pg_hba has "local all all trust".
pg1-socket-path=/var/run/postgresql
pg1-user=scout
