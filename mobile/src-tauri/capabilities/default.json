{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "deep-link:default",
    "pointfinder-nfc:default",
    "pointfinder-push:default",
    "pointfinder-secure-store:default",
    "sql:default",
    "sql:allow-execute",
    "websocket:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://pointfinder.pt/*"
        },
        {
          "url": "https://pointfinder.ch/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://192.168.*/*"
        }
      ]
    }
  ]
}
