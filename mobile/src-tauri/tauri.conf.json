{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PointFinder",
  "version": "1.0.0",
  "identifier": "com.prayer.pointfinder",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev:native",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../web build:native",
    "frontendDist": "../../web/dist-native"
  },
  "app": {
    "windows": [
      {
        "title": "PointFinder",
        "width": 430,
        "height": 932
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "versionCode": 20
    },
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "20",
      "developmentTeam": "ZQ6CKMW9NA"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "pointfinder.pt",
          "pathPrefix": [
            "/tag/",
            "/dashboard"
          ],
          "appLink": true
        },
        {
          "scheme": [
            "https"
          ],
          "host": "pointfinder.ch",
          "pathPrefix": [
            "/tag/",
            "/dashboard"
          ],
          "appLink": true
        }
      ]
    }
  }
}
