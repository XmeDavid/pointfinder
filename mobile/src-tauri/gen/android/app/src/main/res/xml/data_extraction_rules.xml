<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Queue/media and Keystore credentials must remain on the same installation. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
